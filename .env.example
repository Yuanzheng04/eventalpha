# Copy this file to ".env" and fill in your key. .env is auto-loaded by the
# scripts (and should be git-ignored). Nothing else needs your key.

# ---- LLM (OpenAI-compatible) ----
DEEPSEEK_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LANGCHAIN_MODEL_NAME=deepseek-chat

# If you use OpenAI/OpenRouter instead, set OPENAI_API_KEY and the matching
# base URL / model, e.g.:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LANGCHAIN_MODEL_NAME=deepseek/deepseek-chat

# ---- SEC EDGAR (required: a descriptive User-Agent with contact info) ----
SEC_UA=Your Name your@email.com
